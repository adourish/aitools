{
  "SKILLS_ROOT": "G:\\My Drive\\Resources\\Skills",
  "PARA_ROOT": "G:\\My Drive",
  "description": "Configuration for the Skills repository and PARA method locations.",
  "examples": {
    "windows": {
      "SKILLS_ROOT": "G:\\My Drive\\Resources\\Skills",
      "PARA_ROOT": "G:\\My Drive"
    },
    "windows_alt": {
      "SKILLS_ROOT": "C:\\Users\\YourName\\Documents\\Resources\\Skills",
      "PARA_ROOT": "C:\\Users\\YourName\\Documents"
    },
    "linux": {
      "SKILLS_ROOT": "/home/username/GoogleDrive/Resources/Skills",
      "PARA_ROOT": "/home/username/GoogleDrive"
    },
    "mac": {
      "SKILLS_ROOT": "/Users/username/Google Drive/Resources/Skills",
      "PARA_ROOT": "/Users/username/Google Drive"
    }
  },
  "usage": {
    "note": "All skill paths use SKILLS_ROOT, PARA method locations use PARA_ROOT",
    "skills_format": "${SKILLS_ROOT}/automation/skill_daily_planning.md",
    "para_format": "${PARA_ROOT}/03_Areas/Keys/Environments/environments.json",
    "actual_example": "If SKILLS_ROOT is 'C:\\Skills' and PARA_ROOT is 'C:\\GoogleDrive', then paths become 'C:\\Skills\\automation\\skill_daily_planning.md' and 'C:\\GoogleDrive\\03_Areas\\Keys\\Environments\\environments.json'"
  },
  "KEEPASS": {
    "description": "Automation KeePass vault \u2014 unlocked with a key file, no master password. Read via _tools/keepass/keepass_lookup.py. Never commit the database or the key file.",
    "env_overrides": [
      "KEEPASS_DB",
      "KEEPASS_KEY"
    ],
    "database_search_order": [
      "$KEEPASS_DB",
      "~/keys/automation-keys.kdbx",
      "C:\\keys\\automation-keys.kdbx",
      "G:\\My Drive\\Areas\\Keys\\automation-keys.kdbx"
    ],
    "keyfile_search_order": [
      "$KEEPASS_KEY",
      "<database folder>/automation-keys.keyfile",
      "~/.keepass/automation-keys.keyfile",
      "C:\\keys\\automation-keys.keyfile"
    ],
    "groups": [
      "Salesforce",
      "API",
      "Database",
      "DevOps",
      "Other",
      "aitools-environments"
    ],
    "helper": "_tools/keepass/keepass_lookup.py"
  }
}
